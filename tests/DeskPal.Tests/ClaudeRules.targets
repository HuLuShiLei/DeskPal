<Project>
  <!-- Claude Code reads .claude/rules/*.md; they are generated from .cursor/rules/*.mdc on every local build.
       CI skips generation so ClaudeRulesTests catches generated files that were not committed. -->
  <UsingTask TaskName="SyncClaudeRules" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceDir ParameterType="System.String" Required="true" />
      <TargetDir ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
var utf8 = new UTF8Encoding(false);
Directory.CreateDirectory(TargetDir);
var expected = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
foreach (var mdc in Directory.GetFiles(SourceDir, "*.mdc"))
{
    var name = Path.GetFileName(mdc);
    var text = File.ReadAllText(mdc).Replace("\r\n", "\n");
    var match = Regex.Match(text, @"\A---\n(.*?)\n---\n", RegexOptions.Singleline);
    if (!match.Success)
    {
        Log.LogError(".cursor/rules/" + name + " has no frontmatter");
        continue;
    }

    var globs = match.Groups[1].Value.Split('\n')
        .Select(line => Regex.Match(line, @"^globs:\s*(.*)$"))
        .Where(m => m.Success)
        .SelectMany(m => m.Groups[1].Value.Split(','))
        .Select(g => g.Trim())
        .Where(g => g.Length > 0)
        .ToList();

    var sb = new StringBuilder();
    if (globs.Count > 0)
    {
        sb.Append("---\npaths:\n");
        foreach (var g in globs) sb.Append("  - \"").Append(g).Append("\"\n");
        sb.Append("---\n");
    }
    sb.Append("<!-- Generated from .cursor/rules/").Append(name).Append(" by DeskPal.Tests build. Do not edit. -->\n");
    sb.Append(text.Substring(match.Length));

    var target = Path.Combine(TargetDir, Path.ChangeExtension(name, ".md"));
    expected.Add(Path.GetFileName(target));
    var content = sb.ToString();
    if (!File.Exists(target) || File.ReadAllText(target).Replace("\r\n", "\n") != content)
    {
        File.WriteAllText(target, content, utf8);
        Log.LogMessage(MessageImportance.High, "Updated " + target);
    }
}

foreach (var md in Directory.GetFiles(TargetDir, "*.md"))
{
    if (!expected.Contains(Path.GetFileName(md)))
    {
        File.Delete(md);
        Log.LogMessage(MessageImportance.High, "Deleted " + md);
    }
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="SyncClaudeRules" BeforeTargets="Build" Condition="'$(CI)' != 'true'">
    <SyncClaudeRules SourceDir="$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)..\..\.cursor\rules))" TargetDir="$([MSBuild]::NormalizeDirectory($(MSBuildThisFileDirectory)..\..\.claude\rules))" />
  </Target>
</Project>