<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DeskPal.Shared\DeskPal.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NeutralLanguage>zh-CN</NeutralLanguage>
  </PropertyGroup>

  <!-- 界面文案：Strings.resx 是简体中文，Strings.en.resx 是英文。构建时生成 DeskPal.Client.Core.Localization.Strings。 -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx" StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="DeskPal.Client.Core.Localization" StronglyTypedClassName="Strings" PublicClass="true" />
  </ItemGroup>

</Project>
