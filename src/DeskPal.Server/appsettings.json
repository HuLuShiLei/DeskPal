{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=storage/deskpal.db"
  },
  "Jwt": {
    "Issuer": "deskpal",
    "LifetimeDays": 30
  },
  "Auth": {
    "RequireSignupInvite": false,
    "AdminUserNames": []
  },
  "Rooms": {
    "MaxOwnedRoomsPerUser": 5,
    "MaxMembersPerRoom": 20,
    "InviteLifetimeHours": 24
  },
  "Rules": {
    "MinUsers": 5,
    "MinAgreement": 0.8,
    "MinAccountAgeDays": 3
  }
}
