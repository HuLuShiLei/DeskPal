<Window x:Class="DeskPal.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskPal" Width="380" Height="580" MinWidth="320" MinHeight="420"
        WindowStyle="ToolWindow" ShowInTaskbar="False"
        Background="#FFF5F6F8" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="BorderBrush" Value="#FFE3E6EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="OptionalLine" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" DisplayMemberPath="Name" Padding="6,4" />
            <Button Grid.Column="1" x:Name="RoomMenuButton" Content="Room ▾" Margin="8,0,0,0" Click="OnRoomMenuClick" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ConnectionText}" Foreground="Gray" FontSize="12" Margin="2,6,0,8" />

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="我的状态" FontWeight="SemiBold" />
                <TextBlock Text="{Binding MyView.Headline}" FontSize="14" Margin="0,6,0,0" />
                <TextBlock Text="{Binding MyView.App}" Style="{StaticResource OptionalLine}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding MyView.Detail}" Style="{StaticResource OptionalLine}" Foreground="Gray" FontSize="12" Margin="0,2,0,0" />
                <TextBlock Text="{Binding MySource}" Style="{StaticResource OptionalLine}" Foreground="Gray" FontSize="12" Margin="0,2,0,0" />
                <TextBlock Text="{Binding MyVisibleText}" TextWrapping="Wrap" Foreground="#FF5B6472" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="这条分错了" Click="OnCorrectionClick" />
                    <CheckBox Content="暂停分享" IsChecked="{Binding IsPaused}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox IsEditable="True" ItemsSource="{Binding ManualPresets}" Text="{Binding ManualInput, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" ToolTip="手动状态优先于自动识别" />
                    <Button Grid.Column="1" Content="设置" Margin="6,0,0,0" Click="OnSetManualClick" />
                    <Button Grid.Column="2" Content="清除" Margin="6,0,0,0" Click="OnClearManualClick" />
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding EmptyHint}" Visibility="{Binding EmptyHintVisibility}" TextWrapping="Wrap" Foreground="Gray" Margin="2,8" />
                <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Headline}" Margin="0,6,0,0" FontSize="14" />
                                        <TextBlock Text="{Binding App}" Style="{StaticResource OptionalLine}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource OptionalLine}" Foreground="Gray" FontSize="12" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Meta}" Foreground="Gray" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="戳一下" VerticalAlignment="Top" Margin="8,0,0,0" Tag="{Binding UserId}" Click="OnPokeClick" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>