<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DeskPal.Client.Core\DeskPal.Client.Core.csproj" />
    <ProjectReference Include="..\DeskPal.Shared\DeskPal.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>DeskPal</AssemblyName>
    <RootNamespace>DeskPal.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <StartupObject>DeskPal.Client.Program</StartupObject>
  </PropertyGroup>

  <!-- 更新后弹出的「更新内容」读程序目录下的 CHANGELOG.md。 -->
  <ItemGroup>
    <Content Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 前端：web/ 下的 Vite 项目，构建结果复制到输出目录的 web/。没有 Node 时可传 -p:SkipWebBuild=true，用已有的 web/dist。 -->
  <ItemGroup>
    <WebSource Include="web\index.html;web\package.json;web\package-lock.json;web\vite.config.ts;web\tsconfig.json;web\src\**\*" />
    <None Remove="web\**" />
    <Compile Remove="web\**" />
  </ItemGroup>

  <Target Name="NpmInstall" Condition="'$(SkipWebBuild)' != 'true'" Inputs="web\package.json;web\package-lock.json" Outputs="web\node_modules\.install-stamp">
    <Exec Command="npm ci --no-fund --no-audit" WorkingDirectory="web" />
    <Touch Files="web\node_modules\.install-stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildWeb" DependsOnTargets="NpmInstall" Condition="'$(SkipWebBuild)' != 'true'" Inputs="@(WebSource)" Outputs="web\dist\index.html">
    <Exec Command="npm run build" WorkingDirectory="web" />
  </Target>

  <Target Name="IncludeWeb" DependsOnTargets="BuildWeb" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_WebDist Include="web\dist\**" />
      <Content Include="@(_WebDist)" Link="web\%(_WebDist.RecursiveDir)%(_WebDist.Filename)%(_WebDist.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
